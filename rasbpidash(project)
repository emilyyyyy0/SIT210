def load_node_config(): #loads saved node crop settings 
    if os.path.exists(CONFIG_FILE):
        with open(CONFIG_FILE, "r") as file:
            return json.load(file)
    return {}


def save_node_config(config): #check file exists
    with open(CONFIG_FILE, "w") as file:
        json.dump(config, file, indent=4)


node_crop_map = load_node_config()


def check_thresholds(data): //thresholdss
    node_id = data.get("nodeID", "unknown")

    crop_type = node_crop_map.get(node_id, "Leafy greens")
    profile = crop_profiles[crop_type]

    alerts = []

    moisture = float(data.get("moisture", 0))
    temperature = float(data.get("temperature", 0))
    light = float(data.get("light", 0))

    if moisture < profile["min_moisture"]:
        alerts.append("LOW WATER")

    if moisture > profile["max_moisture"]:
        alerts.append("TOO MUCH WATER")

    if temperature < profile["min_temp"]:
        alerts.append("TOO COLD")

    if temperature > profile["max_temp"]:
        alerts.append("TOO HOT")

    if light < profile["min_light"]:
        alerts.append("LOW LIGHT")

    if light > profile["max_light"]:
        alerts.append("TOO MUCH LIGHT")

    if not alerts:
        alerts.append("OK") //if no alerts we okay

    return crop_type, ", ".join(alerts)

#on connection 
def on_connect(client, userdata, flags, rc):
    print("Connected to MQTT broker:", rc) #print connect
    client.subscribe("farm/+/data") #subscribe the farm topic

#on message
def on_message(client, userdata, msg):
    global latest_nodes

    try:
        data = json.loads(msg.payload.decode()) //decode to python
print data
        node_id = data.get("nodeID", "unknown") 
        crop_type, status = check_thresholds(data)

        data["crop"] = crop_type
        data["status"] = status
        data["last_update"] = datetime.now().strftime("%H:%M:%S")

        latest_nodes[node_id] = data

        print("Updated:", data)

    except Exception as e:
        print("Error reading MQTT message:", e) //error msg instead of crashing


def mqtt_thread():
    client = mqtt.Client()
    client.on_connect = on_connect //connects functions
    client.on_message = on_message //connects functions 

    client.connect("localhost", 1883, 60) //connect to mqtt
    client.loop_forever() //loops 

