#delete button
@app.route("/delete/<node_id>")
def delete_node(node_id):
    global node_crop_map

    if node_id in node_crop_map:
        del node_crop_map[node_id] //delete from map
        save_node_config(node_crop_map) 

    return redirect("/config")
