#include "DHT.h"
#include <BH1750.h>
#include <Wire.h>
#include <WiFiNINA.h>
#include <PubSubClient.h>

#define DHTPIN 4
#define DHTTYPE DHT11

const int Soilmoistpin = A1;

DHT dht(DHTPIN, DHTTYPE);
BH1750 lightMeter;

// Node identity
String nodeID = "node1"; //CHANGE THIS FOR EACH NODE eg second plant node2

// WiFi
char ssid[] = "Emily";
char pass[] = "rosepatricia";

// Raspberry Pi MQTT broker IP
char mqttServer[] = "172.20.10.8";   // WOULD NEED TO CHANGE THIS TO YOUR OWN IP TO RUN ON YOUR DEVICES
int mqttPort = 1883;

WiFiClient wifiClient;
PubSubClient mqttClient(wifiClient);

const char* mqttTopic = "farm/node1/data"; //CHANGE THIS FOR EACH NODE eg second plant "farm/node2/data"

//connect to wifi
void connectWiFi() {
  while (WiFi.status() != WL_CONNECTED) {
    Serial.println("Connecting to WiFi...");
    WiFi.begin(ssid, pass);
    delay(3000);
  }

  Serial.println("Connected to WiFi");
}

//mqtt connection
void connectMQTT() {
  while (!mqttClient.connected()) {
    Serial.println("Connecting to MQTT...");

    if (mqttClient.connect("Nano33IoT_Node1")) {
      Serial.println("Connected to MQTT broker");
    } else {
      Serial.print("MQTT failed, rc=");
      Serial.println(mqttClient.state());
      delay(3000);
    }
  }
}

void setup() {
  Serial.begin(9600);

  dht.begin();
  Wire.begin();
  lightMeter.begin();

  connectWiFi();

  mqttClient.setServer(mqttServer, mqttPort);
  connectMQTT();
}

void loop() {
  if (WiFi.status() != WL_CONNECTED) {
    connectWiFi();
  }

  if (!mqttClient.connected()) {
    connectMQTT();
  }

  mqttClient.loop();

  float temp = dht.readTemperature();
  float humidity = dht.readHumidity();
  float lux = lightMeter.readLightLevel();

  int sensorValue = analogRead(Soilmoistpin);
  int moisturePercent = map(sensorValue, 800, 400, 0, 100);
  int lightPercent = map(lux, 0, 600, 0, 100);
  lightPercent = constrain(lightPercent, 0, 100);

  if (isnan(temp) || isnan(humidity)) {
    Serial.println("Sensor read failed");
    delay(30000);
    return;
  }

//json -sends the data to the rasberry pi mqtt
  String payload = "{";
  payload += "\"nodeID\":\"" + nodeID + "\",";
  payload += "\"temperature\":" + String(temp) + ",";
  payload += "\"humidity\":" + String(humidity) + ",";
  payload += "\"light\":" + String(lightPercent) + ",";
  payload += "\"moisture\":" + String(moisturePercent);
  payload += "}";

  Serial.println(payload);

  mqttClient.publish(mqttTopic, payload.c_str());
Serial.print("Raw Moisture Value: "); //simply for testing - remove later
Serial.println(sensorValue);

  delay(30000);
}
